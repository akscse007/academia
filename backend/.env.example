NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/student_saas
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (optional, falls back to local disk when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default platform owner, created on first boot
PLATFORM_OWNER_EMAIL=owner@yourplatform.com
PLATFORM_OWNER_PASSWORD=Owner@12345
PLATFORM_OWNER_NAME=Platform Owner

# Razorpay (optional, for automated verification later)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
