NODE_ENV=development
PORT=5000

# PostgreSQL (Neon, Supabase, Railway, local docker, …)
# Use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL.
DATABASE_URL=""
DIRECT_URL=""

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins (the frontend URLs).
CLIENT_ORIGIN=http://localhost:5173

# Public URL where the FRONTEND is served. Used to build share links
# (student registration / login URLs returned by the API).
# In dev, leaving this blank falls back to the request's origin.
# In production, set it explicitly, e.g. APP_URL=https://edu.yourdomain.com
APP_URL=

# Platform owner created on first boot
PLATFORM_OWNER_EMAIL=owner@yourplatform.com
PLATFORM_OWNER_PASSWORD=Owner@12345
PLATFORM_OWNER_NAME=Platform Owner

# Set true to seed a sample academy + teacher + student on first boot
AUTO_SEED=false

# Cloudinary (optional, falls back to local disk when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional, for automated verification later)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
