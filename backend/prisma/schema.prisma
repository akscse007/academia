generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  platform_owner
  teacher
  student
}

enum UserStatus {
  pending
  active
  rejected
  suspended
}

enum AcademyStatus {
  pending
  active
  suspended
  deactivated
}

enum BatchStatus {
  active
  archived
}

enum PaymentType {
  monthly
  admission
  custom
  late_fee
}

enum PaymentStatus {
  pending
  awaiting_verification
  successful
  failed
  rejected
}

enum AnnouncementTarget {
  all
  batch
  students
}

enum NotificationType {
  approval
  enrollment
  new_note
  announcement
  fee_due
  fee_overdue
  payment_verified
  payment_rejected
  system
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum ExamStatus {
  draft
  published
  closed
}

enum QuestionType {
  mcq
  truefalse
  short
}

model Academy {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  logoUrl         String        @default("")
  address         String        @default("")
  contactNumber   String        @default("")
  email           String        @default("")
  description     String        @default("")
  ownerName       String        @default("")
  welcomeMessage  String        @default("Welcome to our academy!")
  loginBanner     String        @default("")
  dashboardBanner String        @default("")
  primaryColor    String        @default("#2563eb")
  accentColor     String        @default("#1e40af")
  themeMode       String        @default("light")
  upiId           String        @default("")
  paymentQrUrl    String        @default("")
  lateFeePerDay   Decimal       @default(0) @db.Decimal(10, 2)
  gracePeriodDays Int           @default(5)
  currency        String        @default("INR")
  status          AcademyStatus @default(pending)
  trialEndsAt     DateTime?
  subscriptionPlan String       @default("trial")
  subscriptionExpiresAt DateTime?
  customDomain    String        @default("")
  ownerUserId     String        @unique
  owner           User          @relation("AcademyOwner", fields: [ownerUserId], references: [id])
  users           User[]        @relation("AcademyUsers")
  batches         Batch[]
  enrollments     Enrollment[]
  notes           Note[]
  payments        Payment[]
  announcements   Announcement[]
  notifications   Notification[]
  attendances     Attendance[]
  exams           Exam[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String
  phone           String       @default("")
  password        String
  role            UserRole
  status          UserStatus   @default(pending)
  address         String       @default("")
  profilePicUrl   String       @default("")
  academicInfo    String       @default("")
  guardian        String       @default("")
  lastLogin       DateTime?
  academyId       String?
  academy         Academy?     @relation("AcademyUsers", fields: [academyId], references: [id])
  ownedAcademy    Academy?     @relation("AcademyOwner")
  enrollments     Enrollment[]
  payments        Payment[]
  announcementsCreated Announcement[]    @relation("AnnouncementCreator")
  announcementsTargeted AnnouncementStudent[]
  notifications   Notification[]
  notesUploaded   Note[]
  attendanceRecords Attendance[]  @relation("StudentAttendance")
  examAttempts    ExamAttempt[]   @relation("StudentExamAttempts")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([email, academyId])
  @@index([academyId])
}

model Batch {
  id              String        @id @default(cuid())
  academyId       String
  academy         Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name            String
  description     String        @default("")
  subject         String        @default("")
  startDate       DateTime?
  endDate         DateTime?
  schedule        Json          @default("[]")
  monthlyFee      Decimal       @default(0) @db.Decimal(10, 2)
  admissionFee    Decimal       @default(0) @db.Decimal(10, 2)
  capacity        Int?
  status          BatchStatus   @default(active)
  enrollments     Enrollment[]
  notes           NoteBatch[]
  payments        Payment[]
  announcements   AnnouncementBatch[]
  attendances     Attendance[]
  exams           ExamBatch[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([academyId])
}

model Enrollment {
  id              String   @id @default(cuid())
  academyId       String
  academy         Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  studentId       String
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId         String
  batch           Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  status          String   @default("active") // active | removed
  monthlyFeeOverride Decimal? @db.Decimal(10, 2)
  admissionFeeOverride Decimal? @db.Decimal(10, 2)
  discount        Decimal? @db.Decimal(10, 2)
  enrolledAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([studentId, batchId])
  @@index([academyId])
}

model Note {
  id                  String      @id @default(cuid())
  academyId           String
  academy             Academy     @relation(fields: [academyId], references: [id], onDelete: Cascade)
  folder              String      @default("General")
  title               String
  description         String      @default("")
  fileUrl             String
  storageKey          String      @default("")
  fileSize            Int         @default(0)
  mimeType            String      @default("application/pdf")
  published           Boolean     @default(true)
  recordingPermission Boolean     @default(false)
  uploadedById        String?
  uploadedBy          User?       @relation(fields: [uploadedById], references: [id])
  batches             NoteBatch[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([academyId])
}

model NoteBatch {
  noteId  String
  batchId String
  note    Note  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([noteId, batchId])
}

model Payment {
  id              String        @id @default(cuid())
  academyId       String
  academy         Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  studentId       String
  student         User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId         String?
  batch           Batch?        @relation(fields: [batchId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  type            PaymentType   @default(monthly)
  forMonth        String?
  dueDate         DateTime?
  reference       String?       @unique
  upiTxnId        String        @default("")
  screenshotUrl   String        @default("")
  status          PaymentStatus @default(pending)
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String        @default("")
  receiptNo       String?
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([academyId, studentId, forMonth])
}

model Announcement {
  id          String             @id @default(cuid())
  academyId   String
  academy     Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  title       String
  message     String
  targetType  AnnouncementTarget @default(all)
  batches     AnnouncementBatch[]
  students    AnnouncementStudent[]
  createdById String?
  createdBy   User?              @relation("AnnouncementCreator", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([academyId])
}

model AnnouncementBatch {
  announcementId String
  batchId        String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([announcementId, batchId])
}

model AnnouncementStudent {
  announcementId String
  studentId      String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([announcementId, studentId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  academyId  String?
  academy    Academy?         @relation(fields: [academyId], references: [id])
  title      String
  message    String
  type       NotificationType @default(system)
  read       Boolean          @default(false)
  link       String           @default("")
  createdAt  DateTime         @default(now())

  @@index([userId])
}

model Developer {
  id          String   @id @default(cuid())
  name        String   @default("The Developer")
  photoUrl    String   @default("")
  intro       String   @default("")
  about       String   @default("")
  skills      String[] @default([])
  projects    Json     @default("[]")
  email       String   @default("")
  website     String   @default("")
  github      String   @default("")
  linkedin    String   @default("")
  twitter     String   @default("")
  instagram   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  academyId String?
  userId    String?
  action    String
  details   Json?
  ip        String?
  createdAt DateTime @default(now())
}

model Attendance {
  id         String           @id @default(cuid())
  academyId  String
  academy    Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId  String
  student    User             @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus @default(present)
  note       String           @default("")
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([batchId, date, studentId])
  @@index([academyId])
  @@index([studentId])
  @@index([batchId, date])
}

model Exam {
  id              String        @id @default(cuid())
  academyId       String
  academy         Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  title           String
  description     String        @default("")
  instructions    String        @default("")
  durationMinutes Int           @default(30)
  startsAt        DateTime
  endsAt          DateTime
  totalMarks      Int           @default(0)
  status          ExamStatus    @default(draft)
  shuffle         Boolean       @default(false)
  createdById     String?
  batches         ExamBatch[]
  questions       Question[]
  attempts        ExamAttempt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([academyId])
}

model ExamBatch {
  examId  String
  batchId String
  exam    Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([examId, batchId])
}

model Question {
  id           String       @id @default(cuid())
  examId       String
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  order        Int          @default(0)
  type         QuestionType @default(mcq)
  text         String
  options      Json         @default("[]")
  correctIndex Int?
  correctText  String       @default("")
  marks        Int          @default(1)
  createdAt    DateTime     @default(now())

  @@index([examId])
}

model ExamAttempt {
  id          String    @id @default(cuid())
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation("StudentExamAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int       @default(0)
  maxScore    Int       @default(0)
  autoScored  Boolean   @default(true)
  status      String    @default("in_progress")
  answers     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([examId, studentId])
  @@index([examId])
}
